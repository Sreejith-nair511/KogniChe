# NEXORA Environment Configuration
# Copy this to .env and fill in your values.

# Database — SQLite (default, no setup needed)
DATABASE_URL=sqlite:///data/runtime/nexora_runtime.db
SOURCE_DB_PATH=data/source/Recommendations/data/APS-04.db

# Vector index directory
VECTOR_INDEX_DIR=data/runtime/vector_index

# Embedding model (multilingual, supports en/hi/ta/kn/ml/bn/mr/te)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# CORS — set to your Next.js URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM (optional — system works without it)
LLM_API_KEY=
LLM_MODEL=

# Debug mode
DEBUG=false

# Ranking weights (configurable — sum should be ~1.0)
WEIGHT_SEMANTIC=0.40
WEIGHT_PROFILE=0.25
WEIGHT_BEHAVIOUR=0.15
WEIGHT_COLLABORATIVE=0.05
WEIGHT_RATING=0.05
WEIGHT_POPULARITY=0.03
WEIGHT_DIVERSITY=0.07

# Interaction signal weights
SIGNAL_LIKE=0.60
SIGNAL_SAVE=0.80
SIGNAL_CLICK=0.25
SIGNAL_DISLIKE=-0.70
SIGNAL_DISMISS=-0.20
SIGNAL_VIEW=0.05
SIGNAL_SHARE=0.40
